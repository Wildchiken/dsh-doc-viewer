{
  "name": "dsh-doc-viewer",
  "version": "1.8.2",
  "type": "module",
  "description": "Edit your own spreadsheets in place, together with the agent. Also reads PDF, Word and text. Local only.",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "spreadsheet",
    "xlsx",
    "pdf",
    "docx",
    "agent"
  ],
  "author": "Wildchiken",
  "license": "MIT",
  "homepage": "https://github.com/Wildchiken/dsh-doc-viewer#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wildchiken/dsh-doc-viewer.git"
  },
  "bugs": {
    "url": "https://github.com/Wildchiken/dsh-doc-viewer/issues"
  },
  "engines": {
    "dsh": ">=0.2.2-0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "client.viewer.js",
    "src/host/**/*",
    "bin/vision-ocr",
    "vendor/python/**/*",
    "vendor/xlsx/**/*",
    "locale/*.json",
    "cordis.patch.yml",
    "icon.svg",
    "NOTICE.md",
    "README.md",
    "THIRD_PARTY_LICENSES.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-sidebar-documentpreview"
      ]
    }
  },
  "dependencies": {
    "@fortune-sheet/core": "1.0.4",
    "@fortune-sheet/react": "1.0.4",
    "docx": "9.5.1",
    "exceljs": "4.4.0",
    "mammoth": "1.11.0",
    "marked": "18.1.3",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.3.289"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "scripts": {
    "build": "node build/build-client.mjs",
    "test": "node --test \"test/*.test.js\"",
    "build:ocr": "node build/build-ocr.mjs",
    "prepack": "node build/build-client.mjs && node build/build-ocr.mjs && node build/third-party-licenses.mjs"
  },
  "packageManager": "pnpm@12.3.4"
}
